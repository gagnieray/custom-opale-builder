set -e

# Initialize variables with default values
OPALE_BASE="default"
INCLUDE_PLUGINS="no"
PACKAGE_NAME="opale_customized"
PACKAGE_VERSION=""
OUTPUT_DIRECTORY="dist/"

# Define color codes
COLOR_RESET="\033[0m"
COLOR_GREEN="\033[32m"
COLOR_BLUE="\033[34m"
COLOR_RED="\033[31m"

# Function to print help/usage instructions
help() {
    echo -e "${COLOR_GREEN}Usage:${COLOR_RESET} ./$(basename "$0") [OPTIONS] <COMMAND>\n"

    echo -e "${COLOR_GREEN}Options:${COLOR_RESET}"
    echo -e "  -b BASE      Opale base branch to use (default: master)"
    echo -e "  -n NAME      Package name (default: opale_customized)"
    echo -e "  -o DIRECTORY Output directory (default: dist/)"
    echo -e "  -p yes/no    Include plugins stylesheets (default: no)"
    echo -e "  -v VERSION   Package version (optional)"
    echo -e "  -h           Display this help message\n"

    echo -e "${COLOR_GREEN}Commands:${COLOR_RESET}"
    echo -e "  package      Build and package the theme into a .tar.gz archive"
    echo -e "  help         Display this help message\n"

    echo -e "${COLOR_GREEN}Examples:${COLOR_RESET}"
    echo -e "  ./$(basename "$0") -b redmine-5.x -p yes"
    echo -e "  ./$(basename "$0") -n my_theme -v 1.0.0 package"
    echo -e "  ./$(basename "$0") -n custom_theme -o /var/www/redmine/themes\n"

    echo -e "${COLOR_GREEN}Notes:${COLOR_RESET}"
    echo -e "  - Options must be placed before the command"
    echo -e "  - Version is optional; if provided, it's appended to the package name"
    echo -e "  - All files and folders that start with the package name will be deleted from the output directory"
    echo -e "  - The script must be run from the project root directory"
}

# Check for help flag early
if [[ "$1" == "-h" || "$1" == "help" ]]; then
    help
    exit 0
fi

# Read options and corresponding values
while getopts "b:n:o:p:v:h" option; do
    case "$option" in
        b) OPALE_BASE=${OPTARG};;
        n) PACKAGE_NAME=${OPTARG};;
        o) OUTPUT_DIRECTORY=${OPTARG};;
        p) INCLUDE_PLUGINS=${OPTARG};;
        v) PACKAGE_VERSION=${OPTARG};;
        h) help; exit 0;;
        *) help; exit 1;;
    esac
done

# Remove processed options from arguments
shift $((OPTIND - 1))

# Define full package name
if [ -n "${PACKAGE_VERSION}" ]; then
    FULL_PACKAGE_NAME="${PACKAGE_NAME}-${PACKAGE_VERSION}"
else
    FULL_PACKAGE_NAME="${PACKAGE_NAME}"
fi

# Define absolute output path
CURRENT_DIR=$(pwd)
CURRENT_DIR="${CURRENT_DIR%/}/"
if [ "${OUTPUT_DIRECTORY}" != "dist/" ] ; then
    OUTPUT_DIRECTORY="${OUTPUT_DIRECTORY%/}/"

    if [[ "${OUTPUT_DIRECTORY}" == /* ]]; then
        ABS_OUTPUT_PATH="${OUTPUT_DIRECTORY}"
    elif [[ "${OUTPUT_DIRECTORY}" == ./* ]]; then
        ABS_OUTPUT_PATH="${CURRENT_DIR}${OUTPUT_DIRECTORY:2}"
    else
        ABS_OUTPUT_PATH="${CURRENT_DIR}${OUTPUT_DIRECTORY}"
    fi
else
    ABS_OUTPUT_PATH="${CURRENT_DIR}${OUTPUT_DIRECTORY}"
fi

# Function to build the customized theme
build_theme() {
    # Check requirements
    echo -e "${COLOR_BLUE}Checking npm version...${COLOR_RESET}"
    if ! npm -v --silent; then
        echo -e "${COLOR_RED}Install Node.js and npm!${COLOR_RESET}"
        exit 1
    fi
    echo -e "\n${COLOR_BLUE}Checking git version...${COLOR_RESET}"
    if ! git -v; then
        echo -e "${COLOR_RED}Install git!${COLOR_RESET}"
        exit 1
    fi

    # Start build
    echo -e "\n${COLOR_BLUE}Building customized theme based on Opale...${COLOR_RESET}\n"
    rm -rf "${ABS_OUTPUT_PATH}${FULL_PACKAGE_NAME}"*
    mkdir -p "${ABS_OUTPUT_PATH}${FULL_PACKAGE_NAME}"
    cd src/opale
    if [ -f "../_custom-variables.scss" ]; then
        cp ../_custom-variables.scss src/sass
    else
        echo -e "${COLOR_RED}File 'src/_custom-variables.scss' could not be found!${COLOR_RESET}"
        exit 1
    fi
    if [ "${OPALE_BASE}" != "default" ] ; then
        git switch "${OPALE_BASE}"
    fi
    npm install --silent

    # Add _custom-variables.scss to application.scss
    if ! head -1 src/sass/application.scss | grep -q '^@use "custom-variables";'; then
        echo -e "Info: adding @use rule at the top of 'opale/src/sass/application.scss'"
        { echo '@use "custom-variables";'; cat src/sass/application.scss; } > temp && mv temp src/sass/application.scss
    else
        echo -e "Info : @use rule already at the top of 'opale/src/sass/application.scss'"
    fi

    # Build and copy in output directory
    npm run lint
    npm run build
    if [ -d "../favicon" ]; then
      cp -r ../favicon "${ABS_OUTPUT_PATH}${FULL_PACKAGE_NAME}"
    fi
    if [ -d "../images" ]; then
      cp -r ../images "${ABS_OUTPUT_PATH}${FULL_PACKAGE_NAME}"
    fi
    if [ -d "javascripts" ]; then
      cp -r javascripts "${ABS_OUTPUT_PATH}${FULL_PACKAGE_NAME}"
    fi
    if [ "${INCLUDE_PLUGINS}" == "yes" ]; then
      cp -r plugins "${ABS_OUTPUT_PATH}${FULL_PACKAGE_NAME}"
    fi
    cp -r webfonts stylesheets "${ABS_OUTPUT_PATH}${FULL_PACKAGE_NAME}"
    if [ -d "../webfonts" ]; then
      cp ../webfonts/* "${ABS_OUTPUT_PATH}${FULL_PACKAGE_NAME}"/webfonts
    fi
    if [ -f "../README.md" ]; then
      cp ../README.md "${ABS_OUTPUT_PATH}${FULL_PACKAGE_NAME}"
    fi
    cp ../../LICENSE "${ABS_OUTPUT_PATH}${FULL_PACKAGE_NAME}"

    # Restore src/opale/ to default state
    git restore .
    if [ "${OPALE_BASE}" != "default" ] ; then
        git switch master
    fi
    rm src/sass/_custom-variables.scss
    rm -rf node_modules
    echo -e "\n${COLOR_GREEN}Customized theme built successfully in '${ABS_OUTPUT_PATH}${FULL_PACKAGE_NAME}'!${COLOR_RESET}"
}

# Function to package the customized theme
package_theme() {
    build_theme
    echo -e "\n${COLOR_BLUE}Packaging customized theme based on Opale...${COLOR_RESET}\n"
    cd "${ABS_OUTPUT_PATH}"
    tar cvfz "${FULL_PACKAGE_NAME}".tar.gz "${FULL_PACKAGE_NAME}"
    rm -rf "${FULL_PACKAGE_NAME}"
    echo -e "\n${COLOR_GREEN}Customized theme packaged successfully in '${ABS_OUTPUT_PATH}${FULL_PACKAGE_NAME}.tar.gz'!${COLOR_RESET}"
}

# Handle commands
case $1 in
    package) package_theme;;
    help) help;;
    "") build_theme;;
    *) echo -e "Unknown command: $1"; help; exit 1;;
esac
