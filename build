import argparse
import re
import shutil
import subprocess
import sys
import tempfile
import threading
import time
import zipfile
from itertools import cycle
from pathlib import Path


class Colors:
    """ANSI color codes for cross-platform terminal output."""

    RESET = "\033[0m"
    GREEN = "\033[32m"
    RED = "\033[31m"


class OpaleBuildConfig:
    """Configuration for the build process."""

    def __init__(
        self,
        opale_base: str | None = None,
        package_name: str = "opale_customized",
        package_version: str = "",
        output_directory: str = "dist/",
        include_plugins: bool = False,
    ):
        """Initialize configuration with provided or default values."""
        self.opale_base = opale_base
        self.package_name = package_name
        self.package_version = package_version
        self.output_directory = output_directory
        self.include_plugins = include_plugins

        self.project_root = Path(__file__).resolve().parent
        self.abs_output_path = self._resolve_output_path()
        self.full_package_name = self._build_full_package_name()
        self.opale_initial_commit = None

    def _resolve_output_path(self) -> Path:
        """Resolve the absolute output directory path."""
        output_path = Path(self.output_directory)

        if output_path.is_absolute():
            return output_path

        return self.project_root / output_path

    def _build_full_package_name(self) -> str:
        """Build the package directory name."""
        if self.package_version:
            return f"{self.package_name}-{self.package_version}"

        return self.package_name


class CommandRunner:
    """Executes shell commands with error handling."""

    @staticmethod
    def run(
        command: list[str],
        cwd: Path | str | None = None,
    ) -> tuple[int, str, str]:
        """Execute a command and return exit code, stdout, and stderr."""
        try:
            result = subprocess.run(
                command,
                cwd=cwd,
                capture_output=True,
                text=True,
            )
            return result.returncode, result.stdout, result.stderr
        except FileNotFoundError as e:
            return 1, "", str(e)
        except Exception as e:
            return 1, "", f"Command execution failed: {str(e)}"

    @staticmethod
    def run_checked(
        command: list[str],
        cwd: Path | str | None = None,
        error_msg: str = "",
    ) -> None:
        """Execute a command and exit on failure."""
        exit_code, stdout, stderr = CommandRunner.run(command, cwd)

        if exit_code != 0:
            print(f"{Colors.RED}✗{Colors.RESET} {error_msg or stderr}")
            sys.exit(exit_code)


class SimpleSpinner:
    """Simple spinner animation without external dependencies."""

    def __init__(self, message: str = ""):
        self.spinner_chars = cycle(["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"])
        self.message = message
        self.running = False
        self.thread: threading.Thread | None = None

    def start(self) -> None:
        """Start the spinner in a daemon thread."""
        self.running = True
        self.thread = threading.Thread(target=self._spin, daemon=True)
        self.thread.start()

    def stop(self) -> None:
        """Stop the spinner and clear the output line."""
        self.running = False
        if self.thread:
            self.thread.join()
        # Clear the spinner line from the terminal
        print("\r" + " " * 80 + "\r", end="", flush=True)

    def _spin(self) -> None:
        """Display the spinner animation loop."""
        while self.running:
            print(f"\r{next(self.spinner_chars)} {self.message}", end="", flush=True)
            time.sleep(0.1)


def get_minimum_node_version(config: OpaleBuildConfig) -> str:
    """Extract the minimum Node.js version from Opale's workflow file."""

    workflow_file = ".github/workflows/lint.yml"
    opale_src_path = config.project_root / "src" / "opale"

    try:
        command = ["git", "show", f"{config.opale_base}:{workflow_file}"]
        exit_code, stdout, stderr = CommandRunner.run(
            command,
            cwd=opale_src_path,
        )

        if exit_code != 0:
            return ""

        match = re.search(r"node-version:\s*\[\s*(\d+)", stdout)
        return match.group(1) if match else ""

    except Exception:
        return ""


def version_gte(version: str, min_version: str) -> bool:
    """Compare semantic versions (returns True if version >= min_version)."""

    if not version or not min_version:
        return True

    try:
        return int(version.split(".")[0]) >= int(min_version.split(".")[0])
    except (ValueError, IndexError):
        return True


def check_requirements(config: OpaleBuildConfig) -> None:
    """Verify all required tools and report every missing requirement."""

    successes = []
    errors = []

    print("Checking minimum requirements:")

    # Check Node.js installation and version
    exit_code, stdout, stderr = CommandRunner.run(["node", "--version"])

    if exit_code != 0:
        errors.append("Node.js is not installed or is not available")
    else:
        node_version_match = re.search(r"v(\d+)", stdout)

        if not node_version_match:
            errors.append("Could not determine the Node.js version")
        else:
            current_node_version = node_version_match.group(1)
            min_node_version = get_minimum_node_version(config)

            if min_node_version and not version_gte(current_node_version, min_node_version):
                errors.append(
                    f"Node.js version is too old: {min_node_version}.x or newer is required"
                )
            else:
                successes.append("Node.js")

    # Check Npm installation
    exit_code, _, _ = CommandRunner.run(["npm", "--version"])

    if exit_code != 0:
        errors.append("Npm is not installed or is not available")
    else:
        successes.append("Npm")

    # Check Git installation
    exit_code, _, _ = CommandRunner.run(["git", "--version"])

    if exit_code != 0:
        errors.append("Git is not installed or is not available")
    else:
        successes.append("Git")

    if successes:
        for success in successes:
            print(f"{Colors.GREEN}✓{Colors.RESET} {success}")

    if errors:
        print(
            f"{Colors.RED}✗{Colors.RESET} The following requirements are missing or invalid:"
        )

        for error in errors:
            print(f"- {error}")

        sys.exit(1)


def scss_import(opale_path: Path, spinner: SimpleSpinner | None = None) -> None:
    """Ensure '@use "custom-variables";' is present on the first line of application.scss."""

    app_scss = opale_path / "src" / "sass" / "application.scss"

    # Read current content
    with open(app_scss, encoding="utf-8") as f:
        content = f.read()

    # Check if the first line already contains the import
    first_line = content.split("\n")[0] if content else ""
    if '@use "custom-variables"' in first_line:
        return

    # Prepare new content: add import on first line
    new_content = '@use "custom-variables";\n' + content

    # Write atomically: temp file + rename
    temp_path = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            dir=app_scss.parent,
            delete=False,
            suffix=".scss",
        ) as temp_file:
            temp_file.write(new_content)
            temp_path = Path(temp_file.name)

        temp_path.replace(app_scss)
    except Exception as e:
        if spinner:
            spinner.stop()
        # Clean up temp file if something went wrong
        if temp_path and temp_path.exists():
            temp_path.unlink()
        raise RuntimeError(
            f"{Colors.RED}✗{Colors.RESET} Failed to update {app_scss}: {str(e)}"
        ) from e


def prepare_opale(config: OpaleBuildConfig, spinner: SimpleSpinner | None = None) -> None:
    """Prepare the Opale submodule for building."""

    opale_path = config.project_root / "src" / "opale"

    if config.opale_base:
        CommandRunner.run_checked(
            ["git", "checkout", config.opale_base],
            cwd=opale_path,
        )

    # Copy custom variables file
    custom_vars_src = config.project_root / "src" / "_custom-variables.scss"
    custom_vars_dst = opale_path / "src" / "sass" / "_custom-variables.scss"

    if custom_vars_src.exists():
        shutil.copy2(custom_vars_src, custom_vars_dst)
    else:
        if spinner:
            spinner.stop()

        print(
            f"{Colors.RED}✗{Colors.RESET} File 'src/_custom-variables.scss' could not be found"
        )
        raise SystemExit(1)

    # Update application.scss with custom variables import
    scss_import(opale_path, spinner)

    CommandRunner.run_checked(
        ["npm", "ci", "--silent"],
        cwd=opale_path,
    )


def restore_opale(config: OpaleBuildConfig) -> None:
    """Restore the Opale submodule to its default state."""

    opale_path = config.project_root / "src" / "opale"

    # Reset tracked files to their original state
    CommandRunner.run_checked(
        ["git", "reset", "--hard"],
        cwd=opale_path,
    )

    # Remove untracked files, directories, and ignored files
    CommandRunner.run_checked(
        ["git", "clean", "-fdx"],
        cwd=opale_path,
    )

    # Restore the submodule to the commit pinned by the superproject
    CommandRunner.run_checked(
        ["git", "submodule", "update", "--init", "src/opale"],
        cwd=config.project_root,
    )


def get_available_plugins(config: OpaleBuildConfig) -> list[str]:
    """Retrieve all available plugins from the Opale plugins directory."""

    plugins_dir = config.project_root / "src" / "opale" / "plugins"

    if not plugins_dir.exists():
        return []

    return sorted(d.name for d in plugins_dir.iterdir() if d.is_dir() and d.name != "plugins")


def copy_theme_assets(config: OpaleBuildConfig) -> None:
    """Copy theme assets from source directories to the output directory."""

    output_path = config.abs_output_path / config.full_package_name

    assets = [
        ("src/favicon", "favicon"),
        ("src/images", "images"),
        ("src/opale/javascripts", "javascripts"),
        ("src/opale/webfonts", "webfonts"),
        ("src/opale/stylesheets", "stylesheets"),
    ]

    for src, dst in assets:
        src_path = config.project_root / src

        if src_path.exists():
            shutil.copytree(
                src_path,
                output_path / dst,
                dirs_exist_ok=True,
            )

    src_webfonts = config.project_root / "src" / "webfonts"

    if src_webfonts.exists():
        dst_webfonts = output_path / "webfonts"
        dst_webfonts.mkdir(parents=True, exist_ok=True)

        for file_path in src_webfonts.iterdir():
            if file_path.is_file():
                shutil.copy2(file_path, dst_webfonts)

    readme = config.project_root / "src" / "README.md"

    if readme.exists():
        shutil.copy2(readme, output_path)

    license_file = config.project_root / "LICENSE"

    if license_file.exists():
        shutil.copy2(license_file, output_path)


def copy_plugin_assets(
    config: OpaleBuildConfig,
    plugin_name: str,
) -> None:
    """Copy a single plugin's assets to the output directory."""

    suffix = f"-{config.package_version}" if config.package_version else ""

    plugin_out = config.abs_output_path / f"{config.package_name}-{plugin_name}{suffix}"

    if plugin_out.exists():
        shutil.rmtree(plugin_out)

    plugin_out.mkdir(parents=True, exist_ok=True)

    plugin_src = config.project_root / "src" / "opale" / "plugins" / plugin_name

    if plugin_src.exists():
        for item in plugin_src.iterdir():
            if item.is_dir():
                shutil.copytree(
                    item,
                    plugin_out / item.name,
                    dirs_exist_ok=True,
                )
            else:
                shutil.copy2(item, plugin_out)

    license_file = config.project_root / "LICENSE"

    if license_file.exists():
        shutil.copy2(license_file, plugin_out)


def build_theme(
    config: OpaleBuildConfig, show_success: bool = True, spinner: SimpleSpinner | None = None
) -> None:
    """Build the customized theme based on Opale."""

    if show_success:
        print("Building the customized theme based on Opale:")

        spinner = SimpleSpinner()
        spinner.start()

    try:
        output_path = config.abs_output_path / config.full_package_name

        if output_path.exists():
            shutil.rmtree(output_path)

        output_path.mkdir(parents=True, exist_ok=True)

        prepare_opale(config, spinner)

        opale_path = config.project_root / "src" / "opale"
        CommandRunner.run_checked(
            ["npm", "run", "lint"],
            cwd=opale_path,
        )

        # Select build command based on Opale base version
        build_cmd = "build" if config.opale_base == "redmine-5.x" else "build:theme"

        CommandRunner.run_checked(
            ["npm", "run", build_cmd],
            cwd=opale_path,
        )

        copy_theme_assets(config)
        restore_opale(config)

    finally:
        if show_success:
            if spinner:
                spinner.stop()

            print(f"{Colors.GREEN}✓{Colors.RESET} Customized theme built in '{output_path}'")


def build_plugins(
    config: OpaleBuildConfig,
    skip_restore: bool = False,
    show_success: bool = True,
) -> bool:
    """Build the customized plugins based on Opale."""

    spinner = None
    if show_success:
        print("Building the customized plugins based on Opale:")
        spinner = SimpleSpinner()
        spinner.start()

    try:
        prepare_opale(config, spinner)

        opale_path = config.project_root / "src" / "opale"
        CommandRunner.run_checked(
            ["npm", "run", "lint"],
            cwd=opale_path,
        )

        # Select build command based on Opale base version
        build_cmd = "build" if config.opale_base == "redmine-5.x" else "build:plugins"

        CommandRunner.run_checked(
            ["npm", "run", build_cmd],
            cwd=opale_path,
        )

        available = get_available_plugins(config)

        if not available:
            if spinner:
                spinner.stop()

            print(f"{Colors.RED}✗{Colors.RESET} No plugins found in src/opale/plugins")
            return False

        for plugin in available:
            copy_plugin_assets(config, plugin)

        if spinner:
            spinner.stop()
            for plugin in available:
                build_path = config.abs_output_path / plugin
                print(
                    f"{Colors.GREEN}✓{Colors.RESET} "
                    f"Customized plugin '{plugin}' built in '{build_path}'"
                )

        if not skip_restore:
            restore_opale(config)

    except SystemExit:
        if spinner:
            spinner.stop()
        raise

    return True


def package_theme(config: OpaleBuildConfig) -> None:
    """Build and package the theme into a .zip archive."""

    print("Packaging the customized theme:")

    spinner = SimpleSpinner()
    spinner.start()

    try:
        build_theme(config, show_success=False, spinner=spinner)

        archive_name = f"{config.full_package_name}.zip"
        archive_path = config.abs_output_path / archive_name
        theme_dir = config.abs_output_path / config.full_package_name

        with zipfile.ZipFile(archive_path, "w", zipfile.ZIP_DEFLATED) as zf:
            for root, _dirs, files in __import__("os").walk(theme_dir):
                for file in files:
                    file_path = Path(root) / file
                    arcname = file_path.relative_to(config.abs_output_path)
                    zf.write(file_path, arcname)

        shutil.rmtree(theme_dir)

        if spinner:
            spinner.stop()

        print(f"{Colors.GREEN}✓{Colors.RESET} Customized theme packaged in '{archive_path}'")

    except SystemExit:
        if spinner:
            spinner.stop()
        raise


def package_plugins(config: OpaleBuildConfig) -> None:
    """Build and package the customized plugins into .zip archives."""

    print("Packaging the customized plugins:")

    spinner = SimpleSpinner()
    spinner.start()

    try:
        if not build_plugins(config, skip_restore=True, show_success=False):
            if spinner:
                spinner.stop()
            return

        if spinner:
            spinner.stop()

        available = get_available_plugins(config)

        for plugin in available:
            suffix = f"-{config.package_version}" if config.package_version else ""
            pkg_name = f"{config.package_name}-{plugin}{suffix}"
            pkg_dir = config.abs_output_path / pkg_name

            if pkg_dir.exists():
                archive_path = config.abs_output_path / f"{pkg_name}.zip"

                spinner.start()
                try:
                    with zipfile.ZipFile(archive_path, "w", zipfile.ZIP_DEFLATED) as zf:
                        for root, _dirs, files in __import__("os").walk(pkg_dir):
                            for file in files:
                                file_path = Path(root) / file
                                arcname = file_path.relative_to(config.abs_output_path)
                                zf.write(file_path, arcname)

                    shutil.rmtree(pkg_dir)
                finally:
                    if spinner:
                        spinner.stop()

                    print(
                        f"{Colors.GREEN}✓{Colors.RESET} "
                        f"Customized plugin '{plugin}' packaged in '{archive_path}'"
                    )
            else:
                print(f"{Colors.RED}✗{Colors.RESET} Directory not found: '{pkg_dir}'")

        restore_opale(config)

    except SystemExit:
        if spinner:
            spinner.stop()
        raise


def main() -> None:
    """Main entry point: build or package the customized Opale theme and plugins."""

    # Enforce Python 3.10+ for union type syntax (|).
    # This check is intentionally kept to provide a clear error message when
    # the script is launched with an unsupported Python version.
    if sys.version_info < (3, 10):  # noqa: UP036
        print(
            f"{Colors.RED}✗{Colors.RESET} "
            "This script requires Python 3.10 or later. "
            f"You are using Python {sys.version_info.major}.{sys.version_info.minor}."
        )
        raise SystemExit(1)

    parser = argparse.ArgumentParser(
        description="Custom Opale Redmine Theme Builder",
        formatter_class=lambda prog: argparse.RawDescriptionHelpFormatter(
            prog,
            max_help_position=25,
        ),
        add_help=False,
        epilog="""
examples:
  Build the customized theme along with the plugins based on the "redmine-5.x" branch of Opale:
  $ ./%(prog)s -b redmine-5.x -p

  Build and package the theme with the name "my_theme" and version "1.0.0":
  $ ./%(prog)s -n my_theme -v 1.0.0 package

  Build the theme with the name "custom_theme" directly in Redmine's themes directory:
  $ ./%(prog)s -n custom_theme -o /var/www/redmine/themes
""",
    )

    # Define command-line options
    parser.add_argument(
        "-n",
        "--name",
        default="opale_customized",
        help="name of the theme (default: opale_customized)",
    )
    parser.add_argument(
        "-o",
        "--output",
        default="dist/",
        help="output directory where to build or package the theme (default: dist/)",
    )
    parser.add_argument(
        "-b",
        "--base",
        default=None,
        help="specific Opale base branch on which to build your theme",
    )
    parser.add_argument(
        "-v",
        "--version",
        default="",
        help="version to append to the name",
    )
    parser.add_argument(
        "-p",
        "--plugins",
        action="store_true",
        help="build the theme along with the existing plugins stylesheets",
    )
    parser.add_argument(
        "-h",
        "--help",
        action="help",
        help="show this help message and exit",
    )

    # Define the optional positional command argument
    parser.add_argument(
        "command",
        nargs="?",
        choices=["package"],
        default=None,
        help="build and package the theme in a .zip archive",
    )

    args = parser.parse_args()

    # Initialize build configuration from parsed arguments
    config = OpaleBuildConfig(
        opale_base=args.base,
        package_name=args.name,
        package_version=args.version,
        output_directory=args.output,
        include_plugins=args.plugins,
    )

    # Verify all required tools are installed and accessible
    check_requirements(config)

    # Execute the requested command or default action
    if args.command == "package":
        package_theme(config)

        if config.include_plugins:
            package_plugins(config)
    else:
        # Default action: build without packaging
        build_theme(config)

        if config.include_plugins:
            build_plugins(config)


if __name__ == "__main__":
    main()
